# BoliBench environment variables. Placeholders only: copy to .env (git-ignored), uncomment what you use,
# and load it yourself (`set -a; . ./.env; set +a`). Nothing in BoliBench reads .env files.
# Every variable is optional: the core benchmark (validate, run --scripts, run --agent-url) needs none.
# Inventory with where each is read: docs/integrations.md.

# --- Sentry: tracing in examples/ollama_agent.py (uv sync --extra sentry) ---
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=1.0

# --- ElevenLabs: `bolibench run --speech elevenlabs` (stdlib, no extra) ---
# ELEVENLABS_API_KEY=<secret>
# ELEVENLABS_VOICE_ID=<voice id from your voice library>
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_STT_LANGUAGE=hin            # unset = auto-detect
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- MongoDB Atlas: `bolibench export --to mongo` (uv sync --extra mongo) ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
# MONGODB_DB=bolibench

# --- Tiger Data (TimescaleDB + pgvector): `bolibench export --to tiger` (uv sync --extra tiger) ---
# TIGER_DATABASE_URL=postgres://<user>:<password>@<host>:<port>/tsdb?sslmode=require

# --- Temporal: python -m bolibench.temporal_run (uv sync --extra temporal) ---
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=bolibench
# TEMPORAL_API_KEY=<secret, Temporal Cloud only; enables TLS>

# --- Backboard: examples/backboard_agent.py ---
# BACKBOARD_API_KEY=<secret>

# --- Google Gemini API (OpenAI-compatible): hosted Gemma 4, e.g. the agent in live mode (render.yaml) ---
# GEMINI_API_KEY=<secret>

# --- DigitalOcean Gradient serverless inference: alternative hosted agent in live mode ---
# MODEL_ACCESS_KEY=<secret>

# --- Demo server: `bolibench serve` / deploy/start.sh (docs/deployment.md) ---
# AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # DigitalOcean: https://inference.do-ai.run/v1
# AGENT_MODEL=gemma-4-31b-it              # DigitalOcean: gemma-4-31B-it
# AGENT_API_KEY_ENV=GEMINI_API_KEY        # the name of the key variable, not the key (DigitalOcean: MODEL_ACCESS_KEY)
# AGENT_TOOL_MODE=native                  # json for a model without tool calling
# AGENT_REASONING_EFFORT=minimal          # Gemma 4 on the Gemini API; unset elsewhere (openai backend only)
# BOLIBENCH_DEMO_TOKEN=<secret, at least 16 characters: openssl rand -hex 24>
# BOLIBENCH_LIVE_DAILY_CAP=50
# BOLIBENCH_LIVE_TURN_TIMEOUT=240         # seconds per turn
# BOLIBENCH_LIVE_RUN_TIMEOUT=600          # seconds per live run (runs are async)
# BOLIBENCH_CLIENT_IP_HEADER=             # only behind a proxy that sets it (Render: True-Client-IP)
# BOLIBENCH_LIVE_AGENT_URL=               # set by deploy/start.sh; must be localhost
# BOLIBENCH_SUITE=suites/orders
# BOLIBENCH_DEMO=demo
# HOST=127.0.0.1
# PORT=8080

# --- Mastra example agent: examples/mastra-agent (npm start) ---
# MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# TURN_TIMEOUT_S=170

# --- Tests: opt in to live tests that call real services and may cost money ---
# BOLIBENCH_LIVE=1
